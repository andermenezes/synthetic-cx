        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "result_kind": {
          "enum": [
            "scored",
            "boolean"
          ],
          "title": "Result Kind",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "required": [
        "id",
        "evaluator_type",
        "result_kind",
        "evidence_policy"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
