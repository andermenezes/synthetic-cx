        },
        "capabilities": {
          "$ref": "#/$defs/ProviderCapabilities"
        },
        "credential_environment_variable": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Credential Environment Variable",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "const": "openai_compatible",
          "title": "Provider",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "required": [
        "provider",
        "model",
        "base_url",
        "credential_environment_variable",
        "capabilities"
      ],
      "title": "OpenAICompatibleModelConfig",
      "type": "object"
    },
    "OpenAIModelConfig": {
