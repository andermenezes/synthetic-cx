        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "OpenAIModelConfig",
      "type": "object"
    },
    "PersonaConfig": {
      "additionalProperties": false,
      "properties": {
        "behavior_description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Behavior Description"
        },
        "behavioral_rules": {
          "items": {
            "$ref": "#/$defs/BehaviorRule"
