{
  "$defs": {
    "ActionAuthorization": {
      "additionalProperties": false,
      "description": "Scenario-scoped permission for consequential customer choices.",
      "properties": {
        "action": {
          "enum": [
            "payment",
            "purchase",
            "account_change",
            "consent",
            "authentication",
            "destructive"
          ],
          "title": "Action",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "environment": {
          "anyOf": [
            {
              "const": "sandbox",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment"
        },
        "max_amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Amount"
        }
      },
      "required": [
        "action"
      ],
      "title": "ActionAuthorization",
      "type": "object"
    },
    "BehaviorCondition": {
      "additionalProperties": false,
      "properties": {
        "occurrence_at_least": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Occurrence At Least",
          "type": "integer"
        },
        "signal": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Signal",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/BehaviorStateConditions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "signal"
      ],
      "title": "BehaviorCondition",
      "type": "object"
    },
    "BehaviorConfig": {
      "additionalProperties": false,
      "properties": {
        "detectors": {
          "items": {
            "$ref": "#/$defs/BehaviorDetectorConfig"
          },
          "maxItems": 8,
          "title": "Detectors",
          "type": "array"
        }
      },
      "title": "BehaviorConfig",
      "type": "object"
    },
    "BehaviorDetectorConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "type": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "BehaviorDetectorConfig",
      "type": "object"
    },
    "BehaviorEffects": {
      "additionalProperties": false,
      "properties": {
        "abandon": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abandon"
        },
        "abandonment_threshold": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abandonment Threshold"
        },
        "frustration_delta": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Frustration Delta",
          "type": "number"
        },
        "willingness_to_continue_delta": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Willingness To Continue Delta",
          "type": "number"
        }
      },
      "title": "BehaviorEffects",
      "type": "object"
    },
    "BehaviorRule": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "effects": {
          "$ref": "#/$defs/BehaviorEffects"
        },
        "fire": {
          "default": "every_match",
          "enum": [
            "every_match",
            "once"
          ],
          "title": "Fire",
          "type": "string"
        },
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "priority": {
          "title": "Priority",
          "type": "integer"
        },
        "when": {
          "$ref": "#/$defs/BehaviorCondition"
        }
      },
      "required": [
        "id",
        "priority",
        "when",
        "effects"
      ],
      "title": "BehaviorRule",
      "type": "object"
    },
    "BehaviorStateCondition": {
      "additionalProperties": false,
      "properties": {
        "gte": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gte"
        },
        "lte": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lte"
        }
      },
      "title": "BehaviorStateCondition",
      "type": "object"
    },
    "BehaviorStateConditions": {
      "additionalProperties": false,
      "properties": {
        "frustration": {
          "anyOf": [
            {
              "$ref": "#/$defs/BehaviorStateCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "willingness_to_continue": {
          "anyOf": [
            {
              "$ref": "#/$defs/BehaviorStateCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "BehaviorStateConditions",
      "type": "object"
    },
    "ChatOwnership": {
      "additionalProperties": false,
      "description": "Independently attested chat root; child locators are root-relative.",
      "properties": {
        "proof": {
          "enum": [
            "chat_dialog",
            "chat_embed",
            "opener_linked",
            "chat_panel"
          ],
          "title": "Proof",
          "type": "string"
        },
        "root_locator": {
          "$ref": "#/$defs/LocatorConfig"
        }
      },
      "required": [
        "root_locator",
        "proof"
      ],
      "title": "ChatOwnership",
      "type": "object"
    },
    "CommunicationConfig": {
      "additionalProperties": false,
      "properties": {
        "clarification_probability": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Clarification Probability",
          "type": "number"
        },
        "grammar_error_probability": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Grammar Error Probability",
          "type": "number"
        },
        "language": {
          "default": "en-US",
          "enum": [
            "en-US",
            "pt-BR"
          ],
          "title": "Language",
          "type": "string"
        },
        "message_length": {
          "anyOf": [
            {
              "enum": [
                "short",
                "medium",
                "long"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Length"
        },
        "spelling_error_probability": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Spelling Error Probability",
          "type": "number"
        },
        "style": {
          "minLength": 1,
          "title": "Style",
          "type": "string"
        },
        "tone": {
          "minLength": 1,
          "title": "Tone",
          "type": "string"
        },
        "typo_probability": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Typo Probability",
          "type": "number"
        },
        "writing_description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Writing Description"
        }
      },
      "required": [
        "tone",
        "style"
      ],
      "title": "CommunicationConfig",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "evaluator_type": {
                "const": "turn_count"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "max_turns": {
                    "exclusiveMinimum": 0,
                    "title": "Max Turns",
                    "type": "integer"
                  }
                },
                "required": [
                  "max_turns"
                ],
                "title": "TurnCountParameters",
                "type": "object"
              },
              "result_kind": {
                "const": "boolean"
              }
            },
            "required": [
              "parameters"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "evaluator_type": {
                "const": "journey_timeout"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "additionalProperties": false,
                "description": "The observed termination reason supplies the timeout decision.",
                "properties": {},
                "title": "JourneyTimeoutParameters",
                "type": "object"
              },
              "result_kind": {
                "const": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluator_type": {
                "const": "repeated_information"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "max_repeats": {
                    "default": 0,
                    "minimum": 0,
                    "title": "Max Repeats",
                    "type": "integer"
                  }
                },
                "title": "RepeatedInformationParameters",
                "type": "object"
              },
              "result_kind": {
                "const": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluator_type": {
                "const": "semantic_goal_completion"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "expected_facts": {
                    "items": {
                      "pattern": "\\S",
                      "type": "string"
                    },
                    "minItems": 1,
                    "title": "Expected Facts",
                    "type": "array"
                  }
                },
                "required": [
                  "expected_facts"
                ],
                "title": "SemanticGoalParameters",
                "type": "object"
              }
            },
            "required": [
              "parameters"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "threshold": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "result_kind": {
                "const": "scored"
              }
            }
          },
          "then": {
            "properties": {
              "threshold": {
                "type": "number"
              }
            },
            "required": [
              "threshold"
            ]
          }
        }
      ],
      "properties": {
        "evaluator_type": {
          "enum": [
            "turn_count",
            "journey_timeout",
            "repeated_information",
            "semantic_goal_completion"
          ],
          "title": "Evaluator Type",
          "type": "string"
        },
        "evidence_policy": {
          "enum": [
            "required",
            "optional",
            "none"
          ],
          "title": "Evidence Policy",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "result_kind": {
          "enum": [
            "scored",
            "boolean"
          ],
          "title": "Result Kind",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "required": [
        "id",
        "evaluator_type",
        "result_kind",
        "evidence_policy"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "ExecutionLimits": {
      "additionalProperties": false,
      "properties": {
        "browser_action_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Browser Action Timeout Seconds",
          "type": "number"
        },
        "close_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Close Timeout Seconds",
          "type": "number"
        },
        "echo_observation_seconds": {
          "default": 0.25,
          "exclusiveMinimum": 0,
          "title": "Echo Observation Seconds",
          "type": "number"
        },
        "evaluator_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Evaluator Timeout Seconds",
          "type": "number"
        },
        "greeting_grace_seconds": {
          "minimum": 0,
          "title": "Greeting Grace Seconds",
          "type": "number"
        },
        "journey_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Journey Timeout Seconds",
          "type": "number"
        },
        "max_turns": {
          "exclusiveMinimum": 0,
          "title": "Max Turns",
          "type": "integer"
        },
        "model_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Model Timeout Seconds",
          "type": "number"
        },
        "persistence_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Persistence Timeout Seconds",
          "type": "number"
        },
        "response_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Response Timeout Seconds",
          "type": "number"
        },
        "website_action_limit": {
          "default": 32,
          "maximum": 128,
          "minimum": 1,
          "title": "Website Action Limit",
          "type": "integer"
        },
        "website_observation_limit": {
          "default": 64,
          "maximum": 256,
          "minimum": 1,
          "title": "Website Observation Limit",
          "type": "integer"
        }
      },
      "required": [
        "max_turns",
        "journey_timeout_seconds",
        "greeting_grace_seconds",
        "browser_action_timeout_seconds",
        "response_timeout_seconds",
        "model_timeout_seconds",
        "evaluator_timeout_seconds",
        "persistence_timeout_seconds",
        "close_timeout_seconds"
      ],
      "title": "ExecutionLimits",
      "type": "object"
    },
    "InterfaceChannelConfig": {
      "additionalProperties": false,
      "description": "Fixed chat boundary and readers; interaction controls are discovered per turn.",
      "properties": {
        "assistant_message_locator": {
          "$ref": "#/$defs/LocatorConfig"
        },
        "bootstrap_input_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocatorConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bootstrap_send_strategy": {
          "anyOf": [
            {
              "$ref": "#/$defs/SendStrategyConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "customer_message_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocatorConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "frame_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocatorConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message_identity": {
          "$ref": "#/$defs/MessageIdentityConfig"
        },
        "navigation_steps": {
          "items": {
            "$ref": "#/$defs/WebsiteNavigationStep"
          },
          "maxItems": 128,
          "title": "Navigation Steps",
          "type": "array"
        },
        "open_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocatorConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ownership": {
          "$ref": "#/$defs/ChatOwnership"
        },
        "reader_evidence": {
          "default": "marked",
          "enum": [
            "marked",
            "observed_exchange"
          ],
          "title": "Reader Evidence",
          "type": "string"
        },
        "response_completion": {
          "$ref": "#/$defs/ResponseCompletionConfig"
        },
        "type": {
          "const": "webchat_playwright_dynamic",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "type",
        "url",
        "ownership",
        "assistant_message_locator",
        "message_identity",
        "response_completion"
      ],
      "title": "InterfaceChannelConfig",
      "type": "object"
    },
    "JsonValue": {},
    "LocatorConfig": {
      "additionalProperties": false,
      "properties": {
        "exact": {
          "default": true,
