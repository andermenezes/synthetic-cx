      "properties": {
        "credential_environment_variable": {
          "default": "OPENAI_API_KEY",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Credential Environment Variable",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "const": "openai",
          "title": "Provider",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Temperature",
