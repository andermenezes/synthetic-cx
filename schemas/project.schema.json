          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute Name"
        },
        "strategy": {
          "enum": [
            "attribute",
            "dom_node",
            "actor_sequence_content_hash"
