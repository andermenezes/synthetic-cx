            "css"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "value"
      ],
      "title": "LocatorConfig",
      "type": "object"
    },
    "MarkdownReportingConfig": {
