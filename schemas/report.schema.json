{
  "$defs": {
    "ArtifactRecord": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "enum": [
            "captured",
            "omitted",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "status"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "configuration",
            "channel",
            "model",
            "evaluation",
            "persistence",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "causal_event_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causal Event Id"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "category",
        "operation",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "EvaluationResult": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "criterion_id": {
          "title": "Criterion Id",
          "type": "string"
        },
        "evaluator_id": {
          "title": "Evaluator Id",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "evidence_message_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Message Ids",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "severity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unavailable",
            "error"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "evaluator_id",
        "criterion_id",
        "status",
        "required",
        "explanation"
      ],
      "title": "EvaluationResult",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "artifact_location": {
      "title": "Artifact Location",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRecord"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "duration_seconds": {
      "minimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ErrorDetail"
      },
      "title": "Errors",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/EvaluationResult"
      },
      "title": "Findings",
      "type": "array"
    },
    "goal_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluationResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "omissions": {
      "items": {
        "type": "string"
      },
      "title": "Omissions",
      "type": "array"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "passed",
            "failed",
            "error",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "repetition_count": {
      "minimum": 0,
      "title": "Repetition Count",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "termination_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Termination Reason"
    },
    "turn_count": {
      "minimum": 0,
      "title": "Turn Count",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "turn_count",
    "duration_seconds",
    "repetition_count",
    "artifact_location"
  ],
  "title": "Report",
  "type": "object"
}
