{
  "$defs": {
    "ArtifactRecord": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "enum": [
            "captured",
            "omitted",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "status"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "BehavioralTransitionSummary": {
      "additionalProperties": false,
      "description": "Payload-free behavioral report citation with exact detector identity.",
      "properties": {
        "after": {
          "$ref": "#/$defs/PersonaState"
        },
        "applied_rule_ids": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Applied Rule Ids",
          "type": "array"
        },
        "before": {
          "$ref": "#/$defs/PersonaState"
        },
        "detector_id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Detector Id",
          "type": "string"
        },
        "detector_type": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Detector Type",
          "type": "string"
        },
        "detector_version": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Detector Version",
          "type": "string"
        },
        "observation_id": {
          "format": "uuid4",
          "title": "Observation Id",
          "type": "string"
        },
        "occurrence": {
          "exclusiveMinimum": 0,
          "title": "Occurrence",
          "type": "integer"
        },
        "signal": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Signal",
          "type": "string"
        },
        "signal_event_id": {
          "minLength": 1,
          "title": "Signal Event Id",
          "type": "string"
        },
        "source_event_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Event Ids",
          "type": "array"
        },
        "source_message_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Message Ids",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "signal_event_id",
        "signal",
        "occurrence",
        "before",
        "after",
        "detector_id",
        "detector_type",
        "detector_version",
        "source_event_ids"
      ],
      "title": "BehavioralTransitionSummary",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "configuration",
            "channel",
            "model",
            "behavior",
            "evaluation",
            "persistence",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "causal_event_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causal Event Id"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "channel.state",
                "channel.reader",
                "channel.reader_evidence",
                "channel.ownership",
                "channel.observe",
                "channel.options",
                "channel.select_option",
                "channel.controls"
              ],
              "type": "string"
            },
            {
              "enum": [
                "provider_timeout",
                "provider_connection",
                "provider_http_4xx",
                "provider_http_5xx",
                "provider_error",
                "invalid_structured_response",
                "persona_timeout",
                "persona_action_malformed",
                "persona_action_unsupported",
                "persona_action_missing",
                "persona_action_ambiguous",
                "persona_option_unavailable",
                "persona_text_unavailable",
                "persona_adapter_error",
                "unknown_model_failure"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "category",
        "operation",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "EvaluationResult": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "criterion_id": {
          "title": "Criterion Id",
          "type": "string"
        },
        "evaluator_id": {
          "title": "Evaluator Id",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "evidence_message_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Message Ids",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "severity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unavailable",
            "error"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "evaluator_id",
        "criterion_id",
        "status",
        "required",
        "explanation"
      ],
      "title": "EvaluationResult",
      "type": "object"
    },
    "JsonValue": {},
    "ObservationTopic": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "ObservationTopic",
      "type": "object"
    },
    "PersonaFeedback": {
      "additionalProperties": false,
      "properties": {
        "experience_truncated": {
          "default": false,
          "title": "Experience Truncated",
          "type": "boolean"
        },
        "language": {
          "enum": [
            "en-US",
            "pt-BR"
          ],
          "title": "Language",
          "type": "string"
        },
        "partial_experience": {
          "title": "Partial Experience",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "cancelled",
                "no_experience",
                "unsupported",
                "persona_unavailable",
                "reflection_failed",
                "reflection_timeout",
                "invalid_feedback"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/PersonaFeedbackResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "topics": {
          "items": {
            "$ref": "#/$defs/ObservationTopic"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Topics",
          "type": "array"
        }
      },
      "required": [
        "status",
        "language",
        "topics",
        "partial_experience"
      ],
      "title": "PersonaFeedback",
      "type": "object"
    },
    "PersonaFeedbackResponse": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Summary",
          "type": "string"
        },
        "topics": {
          "items": {
            "$ref": "#/$defs/TopicImpression"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Topics",
          "type": "array"
        }
      },
      "required": [
        "summary",
        "topics"
      ],
      "title": "PersonaFeedbackResponse",
      "type": "object"
    },
    "PersonaState": {
      "additionalProperties": false,
      "description": "Owned state copied from configuration for each run.",
      "properties": {
        "abandoned": {
          "default": false,
          "title": "Abandoned",
          "type": "boolean"
        },
        "frustration": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Frustration",
          "type": "number"
        },
        "turn_number": {
          "default": 0,
          "minimum": 0,
          "title": "Turn Number",
          "type": "integer"
        },
        "willingness_to_continue": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Willingness To Continue",
          "type": "number"
        }
      },
      "title": "PersonaState",
      "type": "object"
    },
    "TopicImpression": {
      "additionalProperties": false,
      "properties": {
        "evidence_message_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence Message Ids",
          "type": "array"
        },
        "impression": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Impression",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "not_observed"
          ],
          "title": "Status",
          "type": "string"
        },
        "topic_id": {
          "minLength": 1,
          "title": "Topic Id",
          "type": "string"
        }
      },
      "required": [
        "topic_id",
        "status",
        "impression"
      ],
      "title": "TopicImpression",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_location": {
      "title": "Artifact Location",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRecord"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "behavior_completeness": {
      "default": "unavailable",
      "enum": [
        "unavailable",
        "complete",
        "prefix"
      ],
      "title": "Behavior Completeness",
      "type": "string"
    },
    "behavior_observation_count": {
      "default": 0,
      "minimum": 0,
      "title": "Behavior Observation Count",
      "type": "integer"
    },
    "behavior_prefix_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Behavior Prefix Reason"
    },
    "behavior_signal_count": {
      "default": 0,
      "minimum": 0,
      "title": "Behavior Signal Count",
      "type": "integer"
    },
    "behavior_transitions": {
      "items": {
        "$ref": "#/$defs/BehavioralTransitionSummary"
      },
      "title": "Behavior Transitions",
      "type": "array"
    },
    "conversation_duration_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Duration Seconds"
    },
    "duration_seconds": {
      "minimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ErrorDetail"
      },
      "title": "Errors",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/EvaluationResult"
      },
      "title": "Findings",
      "type": "array"
    },
    "goal_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluationResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "omissions": {
      "items": {
        "type": "string"
      },
      "title": "Omissions",
      "type": "array"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "passed",
            "failed",
            "error",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "persona_feedback": {
      "anyOf": [
        {
          "$ref": "#/$defs/PersonaFeedback"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "repetition_count": {
      "minimum": 0,
      "title": "Repetition Count",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "termination_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Termination Reason"
    },
    "turn_count": {
      "minimum": 0,
      "title": "Turn Count",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "turn_count",
    "duration_seconds",
    "repetition_count",
    "artifact_location"
  ],
  "title": "Report",
  "type": "object"
}
